# Local development works without credentials. Never use development mode online.
APP_MODE=development
APP_ORIGIN=http://localhost:3000
PORT=3000
LOCAL_DATA_DIR=.local
# Production: APP_MODE=production, NODE_ENV=production, HTTPS origin.
# Supabase transaction/session pooler URI, with TLS. Server-only.
DATABASE_URL=
# Optional path to the provider's trusted root CA PEM (never disable TLS verification).
DATABASE_CA_PATH=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=life-admin-originals
# Real extraction is unavailable until this is set; no simulated fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Life Admin Inbox <reminders@example.com>
# Development email delivery is restricted to this exact verified destination.
DEV_EMAIL_TO=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Development push requires an exact subscription endpoint allowlist (comma separated).
DEV_PUSH_ENDPOINTS=
# Set to 1 for combined local server + worker. Production runs a separate worker.
RUN_WORKER=1
